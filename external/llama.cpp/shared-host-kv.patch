+def test_router_cpu_model_with_cuda_dynamic_kv(tmp_path, monkeypatch):
+    # Use a local artifact: CPU inference must retain native allocation even
+    # when this same host enables CUDA demand allocation for its GPU workers.
+    model = os.environ.get("LLAMA_CPU_MODEL_TEST_PATH")
+    if not model:
+        pytest.skip("set LLAMA_CPU_MODEL_TEST_PATH to a local CPU-capable GGUF")
+    monkeypatch.setenv("LLAMA_CUDA_DYNAMIC_KV", "1")
+    preset = tmp_path / "models.ini"
