+                      "\nctx-size = 4096\ngpu-layers = 0\nload-on-startup = false\n")
+    server.models_preset = str(preset)
+    try:
+        server.start()
+        assert _get_model_status("cpu") == "unloaded"
+        # Exercise allocation and a real decode through the router, twice across
+        # unload/reload, rather than only checking buffer classification.
+        for _ in range(2):
