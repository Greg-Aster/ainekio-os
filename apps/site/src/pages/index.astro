---
import ChatLayout from '../components/ChatLayout.svelte';
import LeftSidebar from '../components/LeftSidebar.svelte';
import RightSidebar from '../components/RightSidebar.svelte';
import CenterContent from '../components/CenterContent.svelte';
import ThemeToggle from '../components/ThemeToggle.astro';
import ThemeInit from '../components/ThemeInit.astro';
import AuthGate from '../components/AuthGate.svelte';
import BackendConnectionStatus from '../components/BackendConnectionStatus.svelte';
import '../styles/tailwind.css';
import '../styles/chat-animations.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>MetaHuman OS</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ThemeInit />
  </head>
  <body>
    <BackendConnectionStatus client:only="svelte" />
    <!-- Authentication Gate - ONLY renders children when authenticated -->
    <!-- Main app is a child, so it DOES NOT load until user is logged in -->
    <AuthGate client:only="svelte">
      <!-- Main Application - only renders when AuthGate confirms authentication -->
      <div id="main-app">
        <ChatLayout client:only="svelte">
          <ThemeToggle slot="header-actions" />
          <LeftSidebar slot="left-sidebar" client:only="svelte" />
          <CenterContent slot="center" client:only="svelte" />
          <RightSidebar slot="right-sidebar" client:only="svelte" />
        </ChatLayout>
      </div>
    </AuthGate>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    width: 100%;
    overflow: hidden;
  }

  html {
    background: white;
    color: rgb(17 24 39);
  }

  html.dark {
    background: rgb(3 7 18);
    color: rgb(243 244 246);
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
</style>
