{
  "version": "1.0.0",
  "activeBackend": "claude-code",
  "backends": {
    "claude-code": {
      "description": "Claude Code CLI",
      "enabled": true,
      "command": "claude",
      "args": [
        "--print"
      ],
      "timeout": 60000
    },
    "codex": {
      "description": "OpenAI Codex CLI",
      "enabled": true,
      "command": "codex",
      "args": [
        "exec",
        "--color",
        "always",
        "--json",
        "--config",
        "service_tier=\"fast\"",
        "--config",
        "features.fast_mode=true"
      ],
      "reasoningEffort": "low",
      "timeout": 120000,
      "dangerouslySkipPermissions": true
    },
    "gemini": {
      "description": "Google Antigravity Gemini CLI",
      "enabled": true,
      "command": "agy",
      "args": [
        "--input-format",
        "stream-json",
        "--output-format",
        "stream-json",
        "--disable-slash-commands"
      ],
      "reasoningEffort": "low",
      "timeout": 120000,
      "dangerouslySkipPermissions": true
    }
  },
  "escalation": {
    "enabled": true,
    "defaultBackend": "claude-code",
    "escalateOnStuck": true,
    "escalateOnRepeatedFailures": true,
    "maxRetries": 2
  }
}
