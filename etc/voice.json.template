{
  "tts": {
    "provider": "piper",
    "piper": {
      "binary": "./bin/piper/piper",
      "model": "./out/voices/en_US-ryan-high.onnx",
      "config": "./out/voices/en_US-ryan-high.onnx.json",
      "speakingRate": 1,
      "outputFormat": "wav"
    },
    "kokoro": {
      "langCode": "a",
      "voice": "af_heart",
      "speed": 1,
      "useCustomVoicepack": false,
      "customVoicepackPath": "{PROFILE_DIR}/out/voices/kokoro-voicepacks/default.pt",
      "normalizeCustomVoicepacks": true,
      "outputFormat": "wav",
      "autoFallbackToPiper": true
    }
  },
  "stt": {
    "provider": "whisper",
    "whisper": {
      "model": "base.en",
      "device": "cpu",
      "computeType": "int8",
      "language": "en"
    }
  },
  "cache": {
    "enabled": true,
    "directory": "./out/voice-cache",
    "maxSizeMB": 500
  }
}
