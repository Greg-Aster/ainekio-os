#!/usr/bin/env python3
"""Existing systemd lifecycle; llama.cpp owns on-demand model loading and sleep."""
import hashlib
import json
import os
import shlex
from urllib.parse import urlparse
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def systemctl(*args):
    return subprocess.run(['systemctl', '--user', *args], check=True,
                          text=True, stdout=subprocess.PIPE).stdout


def services(selection=None):
    units = [line.split()[0] for line in systemctl(
        'list-unit-files', '--type=service', '--no-legend', '--no-pager').splitlines() if line.strip()]
    # Uninstantiated systemd templates have no process or effective properties.
    units = [unit for unit in units if not unit.endswith('@.service')]
    if not units:
        return []
    descriptions = systemctl('show', *units, '--property=Id,WorkingDirectory,ExecStart')
    selected = []
    for description in descriptions.strip().split('\n\n'):
        properties = dict(line.split('=', 1) for line in description.splitlines() if '=' in line)
        if properties.get('WorkingDirectory') != str(ROOT):
            continue
        command = properties.get('ExecStart', '')
        on_demand = f'path={ROOT}/bin/llama-cpp-services ;' in command and ' serve ' in command
        if not on_demand:
            continue
        if selection is not None:
            arguments = shlex.split(command.split('argv[]=', 1)[1].split(' ;', 1)[0])
            options = {}
            for index, argument in enumerate(arguments):
                key, separator, value = argument.partition('=')
                if key in ('--port', '--host', '--alias', '-a', '--model', '-m'):
                    options[key] = value if separator else arguments[index + 1]
            alias = options.get('--alias', options.get('-a'))
            model = options.get('--model', options.get('-m', ''))
            names = (alias or Path(model).name).split(',')
            port = int(options.get('--port', '8080'))
            host = options.get('--host', '127.0.0.1')
            loopback = {'127.0.0.1', 'localhost', '::1'}
            def matches(item):
                endpoint = urlparse(item['endpoint'])
                local_host = endpoint.hostname == host or (
                    endpoint.hostname in loopback and host in loopback | {'0.0.0.0', '::'})
                return (endpoint.scheme == 'http' and local_host
                        and (endpoint.port or 80) == port and item['model'] in names)
            if not any(matches(item) for item in selection):
                continue
        selected.append(properties['Id'])
    return selected


def serve(binary, arguments):
    # Keep inference options in the existing unit. Only move its model identity
    # into a native preset, so the listener starts without allocating weights.
    remaining = []
    identity = {}
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        key, separator, value = argument.partition('=')
        if key in ('--model', '-m', '--alias', '-a', '--mmproj', '-mm'):
            if not separator:
                index += 1
                value = arguments[index]
            identity['model' if key in ('--model', '-m') else 'mmproj' if key in ('--mmproj', '-mm') else 'alias'] = value
        else:
            remaining.append(argument)
        index += 1
    model = identity['model']
    alias = identity.get('alias', Path(model).name)
    runtime = Path(os.environ['XDG_RUNTIME_DIR']) / 'metahuman-llama'
    runtime.mkdir(parents=True, exist_ok=True)
    preset = runtime / (hashlib.sha256(json.dumps([binary, arguments]).encode()).hexdigest() + '.ini')
    projector = f"mmproj = {identity['mmproj']}\n" if 'mmproj' in identity else ''
    preset.write_text(f'version = 1\n\n[{alias}]\nalias = {alias}\nmodel = {model}\n{projector}load-on-startup = false\n')
    # Five minutes is the owner's installation policy. An explicit unit setting
    # can configure another native idle interval without an application timer.
    if not any(arg.split('=')[0] == '--sleep-idle-seconds' for arg in remaining):
        remaining += ['--sleep-idle-seconds', '300']
    os.execv(binary, [binary, *remaining, '--models-preset', str(preset)])


def main():
    operation = sys.argv[1] if len(sys.argv) > 1 else ''
    if operation == 'serve':
        serve(sys.argv[2], sys.argv[3:])
    elif operation == 'stop' or operation == 'start' and len(sys.argv) == 3:
        selection = json.loads(sys.argv[2]) if operation == 'start' else None
        selected = services(selection)
        if selected:
            systemctl(operation, *selected)
    else:
        print('Usage: llama-cpp-services start SELECTION_JSON | stop | serve LLAMA_SERVER [arguments...]', file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
