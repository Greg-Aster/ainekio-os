#!/usr/bin/env python3
"""Install/start this computer's native llama.cpp service, independent of its clients."""
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
from urllib.parse import urlparse

UNIT = 'llama-cpp.service'


def systemctl(*args):
    return subprocess.run(['systemctl', '--user', *args], check=True,
                          text=True, stdout=subprocess.PIPE).stdout


def option(arguments, name, default=None):
    for index, argument in enumerate(arguments):
        key, separator, value = argument.partition('=')
        if key == name:
            return value if separator else arguments[index + 1]
    return default


def start(selection):
    if not selection:
        return
    local = {'127.0.0.1', 'localhost', '::1'}
    endpoints = [urlparse(item['endpoint']) for item in selection]
    if not any(endpoint.hostname in local for endpoint in endpoints):
        return
    # One known host unit. Never discover or start per-application/model units.
    description = systemctl('show', UNIT, '--property=ExecStart')
    if 'argv[]=' not in description:
        raise ValueError(f'{UNIT} is not installed on this computer')
    arguments = shlex.split(description.split('argv[]=', 1)[1].split(' ;', 1)[0])
    host = option(arguments, '--host', '127.0.0.1')
    port = int(option(arguments, '--port', '8080'))
    if any(endpoint.scheme == 'http' and (endpoint.port or 80) == port and (
            endpoint.hostname == host or endpoint.hostname in local and host in local | {'0.0.0.0', '::'})
           for endpoint in endpoints):
        systemctl('start', UNIT)
    # Remote endpoints belong to their configured computer's service manager.


def install(binary, arguments):
    binary = str(Path(binary).resolve())
    if not option(arguments, '--models-preset'):
        raise ValueError('install requires --models-preset PATH')
    def quote(value):
        return '"' + value.replace('\\', '\\\\').replace('"', '\\"').replace('%', '%%') + '"'
    directory = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'systemd/user'
    directory.mkdir(parents=True, exist_ok=True)
    # The installed unit invokes the native binary, not this repo or either app.
    unit = ('[Unit]\nDescription=Shared native llama.cpp inference on this computer\n\n'
            '[Service]\nType=simple\n'
            f'Environment={quote("LD_LIBRARY_PATH=" + str(Path(binary).parent))}\n'
            'Environment=LLAMA_CUDA_DYNAMIC_KV=1\n'
            'ExecStart=' + ' '.join(quote(arg) for arg in [binary, *arguments]) + '\n\n'
            '[Install]\nWantedBy=default.target\n')
    (directory / UNIT).write_text(unit)
    systemctl('daemon-reload')
    systemctl('enable', UNIT)


def main():
    operation = sys.argv[1] if len(sys.argv) > 1 else ''
    if operation == 'install' and len(sys.argv) >= 5:
        install(sys.argv[2], sys.argv[3:])
    elif operation == 'start' and len(sys.argv) == 3:
        start(json.loads(sys.argv[2]))
    else:
        print('Usage: llama-cpp-services install LLAMA_SERVER --models-preset PATH [native options...] | start SELECTION_JSON', file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
