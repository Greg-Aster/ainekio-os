#!/usr/bin/env bash
# Delegate process and configuration ownership to Core.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"
exec node --import tsx --input-type=module -e '
import { loadLocalModelsConfig, startLocalModelService } from "./packages/core/src/local-model-service-manager.ts";
const config = loadLocalModelsConfig();
if (!config.enabled || !config.autoStart) {
  console.log("Local model service disabled or autoStart=false in config");
  process.exit(0);
}
process.exit(await startLocalModelService() ? 0 : 1);
'
