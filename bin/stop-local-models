#!/usr/bin/env bash
# Delegate process and configuration ownership to Core.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"
exec node --import tsx --input-type=module -e '
import { stopLocalModelService } from "./packages/core/src/local-model-service-manager.ts";
await stopLocalModelService();
process.exit(0);
'
